PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/cropmind
GEMINI_API_KEY=your_gemini_api_key_here

# Authentication Configurations
JWT_SECRET=replace_with_a_long_random_string
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# URL Configurations for CORS and OAuth redirection
FRONTEND_URL=http://localhost:5173

# Set to "production" on the deployed server. Enables: required JWT_SECRET,
# no in-memory DB fallback, no sandbox OAuth, strict CORS.
NODE_ENV=development

# Optional: free key from data.gov.in for live mandi prices
DATA_GOV_API_KEY=

# Number of proxies in front of the backend (Render = 1; via Vercel rewrite may need 2)
TRUST_PROXY=1
